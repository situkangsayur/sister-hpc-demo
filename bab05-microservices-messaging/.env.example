# Salin ke .env lalu sesuaikan. File .env tidak di-commit.
# Di server lab ganti dengan 10.100.21.22 agar bisa diakses lewat wg0.
BIND_ADDR=127.0.0.1
# Nilai contoh untuk demo lokal, bukan kredensial asli.
POSTGRES_PASSWORD=changeme
APISIX_KEY=changeme-storefront-key
# Role replikasi untuk Debezium (CDC mata kuliah Data Engineering, repo de-demo).
# Dibuat sekali saat volume pgdata baru; ganti nilai lalu "docker compose down -v" bila perlu.
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=changeme-debezium
