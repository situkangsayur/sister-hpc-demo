# Salin menjadi .env (jangan di-commit).
# Alamat ikat port host. Lokal: 127.0.0.1 ; server lab (akses lewat wg0): 10.100.21.22
BIND_ADDR=127.0.0.1
# Password admin Grafana. Ganti sebelum dipakai di server lab.
GRAFANA_ADMIN_PASSWORD=changeme
# Regex compose project yang lognya diambil Alloy. Default hanya demo kelas (sister-*).
# Isi ".+" bila memang ingin semua container berlabel compose.
LOG_PROJECT_REGEX=sister-.*
