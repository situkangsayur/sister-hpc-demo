# Alamat ikat port host. Di server lab: 10.100.21.22 (akses lewat wg0).
BIND_ADDR=127.0.0.1
# Delay dan packet loss buatan (tc netem) di sisi probe saat start. RTT antar container
# hampir nol, jadi tanpa delay perbedaan h1/h2/h3 tidak terlihat. Bisa diubah dari UI.
NETEM_DELAY_MS=25
NETEM_LOSS_PCT=0
# Nama tambahan di SAN certificate (pisah koma), mis. IP server lab agar curl dari host lolos.
EXTRA_SANS=localhost,127.0.0.1
