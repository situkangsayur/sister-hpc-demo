# Alamat ikat port host. 127.0.0.1 untuk laptop; 10.100.21.22 di server lab (akses lewat wg0).
BIND_ADDR=127.0.0.1
# CPU yang boleh dipakai container lab (cpuset). Go 1.24 membaca afinitas CPU ini untuk
# NumCPU dan GOMAXPROCS bawaan, sehingga hasil worker pool sama di laptop dan server.
# Laptop dengan 2 core: isi 0-1.
LAB_CPUSET=0-3
