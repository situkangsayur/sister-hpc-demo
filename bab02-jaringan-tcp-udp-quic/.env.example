# Alamat host tempat port demo dibuka. Di server lab pakai 10.100.21.22 (wg0).
BIND_ADDR=127.0.0.1
# Tiga oktet pertama subnet internal. Sengaja di luar pool otomatis Docker (172.17-31.x, 192.168.x)
# agar tidak bentrok dengan network default proyek lain; ubah bila bentrok dengan jaringan kantor.
KLIEN_NET=10.202.2
SERVER_NET=10.202.3
