# Salin menjadi .env (jangan di-commit), atau jalankan `bash buat-env.sh` untuk password acak.
# Di server lab ganti BIND_ADDR=10.100.21.22 agar bisa diakses lewat wg0.
BIND_ADDR=127.0.0.1

# Gitea: pemilik repo app & gitops (admin), dan user bot yang dipakai Jenkins untuk commit ke gitops.
GITEA_ADMIN_USER=demo
GITEA_ADMIN_PASSWORD=changeme-gitea
GITEA_BOT_USER=jenkins-bot
GITEA_BOT_PASSWORD=changeme-bot

JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=changeme-jenkins

# User Argo CD selalu "admin".
ARGOCD_ADMIN_PASSWORD=changeme-argocd

K3S_TOKEN=changeme-k3s
